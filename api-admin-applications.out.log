          OFFSET @p ROWS FETCH NEXT @p1 ROWS ONLY
      ) AS [j0]
      INNER JOIN [Organizations] AS [o] ON [j0].[OrganizationId] = [o].[Id]
      INNER JOIN [Departments] AS [d] ON [j0].[DepartmentId] = [d].[Id]
      INNER JOIN [RecruiterProfiles] AS [r] ON [j0].[RecruiterProfileId] = [r].[Id]
      INNER JOIN [Users] AS [u] ON [r].[UserId] = [u].[Id]
      ORDER BY [j0].[CreatedAt] DESC
